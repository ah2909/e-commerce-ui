{
  "name": "e-commerce-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts/openapi/generate-api.mjs next.config.ts vitest.config.ts eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "api:generate": "node scripts/openapi/generate-api.mjs",
    "api:check": "node scripts/openapi/generate-api.mjs --check",
    "postinstall": "npm --prefix scripts/openapi ci",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run api:check && npm run lint && npm run typecheck && npm test && npm run build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,mjs,json}\" .prettierrc.json README.md docs/shadcn-ui.md",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,mjs,json}\" .prettierrc.json README.md docs/shadcn-ui.md"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@tanstack/react-query": "5.104.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "npm:@typescript/typescript6@6.0.3",
    "vitest": "5.0.3"
  }
}
